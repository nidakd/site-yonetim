# Kopyalayıp .env olarak kaydedin. .env asla commit edilmez.

# Uygulama SÜPER KULLANICI OLMAYAN bir rolle bağlanmalı; aksi halde PostgreSQL RLS devre dışı kalır.
DATABASE_URL=postgres://site_yonetim_app@localhost:5432/site_yonetim

# Canlı ortamda zorunlu (config.settings.prod)
# SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">
# ALLOWED_HOSTS=panel.ornek.com
# ADMIN_URL=<tahmin edilemeyen-bir-yol>/
# REDIS_URL=redis://localhost:6379/0
# EMAIL_HOST=smtp.ornek.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Site Yönetim <bildirim@ornek.com>
# SMS sağlayıcısı: canlıda ayarlanana kadar gönderim kapalıdır (sakin girişi çalışmaz).
# SMS_BACKEND=apps.comms.sms.ConsoleBackend
